@@ -156,6 +170,8 @@ func BuildTelephonySerializer(data TelephonyCallData, getKey GetAPIKeyFunc) seri
 		)
 	case "exotel":
 		return exotel.NewSerializer(data.StreamSid, data.CallSid, nil)
+	case "vobiz":
+		return vobiz.NewSerializer(data.StreamSid, data.CallSid, nil)
 	default:
 		return nil
 	}
