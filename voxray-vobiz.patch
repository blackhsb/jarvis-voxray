+	col := &collectProcessor{}
+	p.SetNext(col)
+	for n := 0; n < 160; n++ {
+		b := make([]byte, 640)
+		if n < 50 {
+			for i := 0; i < 320; i++ {
+				binary.LittleEndian.PutUint16(b[i*2:], uint16(int16(800*math.Sin(float64(i)*2*math.Pi*440/16000))))
+			}
+		}
+		if err := p.ProcessFrame(context.Background(), frames.NewAudioRawFrame(b, 16000, 1, 0), processors.Downstream); err != nil {
+			t.Fatal(err)
