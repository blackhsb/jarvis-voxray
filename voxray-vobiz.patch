+func TestQuietPhoneSpeechCompletes(t *testing.T) {
+	v := vad.NewEnergyDetectorWithParams(vad.Params{Confidence: .5, MinVolume: .005, Threshold: .01, StopSecs: .3})
+	a := turn.NewSilenceTurnAnalyzer(turn.Params{StopSecs: 1.5})
