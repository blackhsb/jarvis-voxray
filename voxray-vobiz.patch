diff --git a/pkg/frames/serialize/vobiz/vobiz.go b/pkg/frames/serialize/vobiz/vobiz.go
new file mode 100644
index 0000000..bc9f4bc
--- /dev/null
+++ b/pkg/frames/serialize/vobiz/vobiz.go
@@ -0,0 +1,224 @@
+// Package vobiz provides Vobiz WebSocket protocol serializer.
+// Vobiz uses Twilio-compatible input (start/media/stop) but expects
+// playAudio/clearAudio output format.
+package vobiz
+
+import (
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"github.com/Voxray-AI/Voxray/pkg/logger"
+	"math"
+	"strings"
+
+	"github.com/Voxray-AI/Voxray/pkg/audio"
+	"github.com/Voxray-AI/Voxray/pkg/frames"
+	"github.com/Voxray-AI/Voxray/pkg/frames/serialize"
+)
+
+// Serializer implements serialize.Serializer for Vobiz.
+type Serializer struct {
+	StreamSid  string
+	CallSid    string
+	SampleRate int
+	VobizRate  int
+	Encoding   string
+	chunks     int
+	sumSquares float64
+	samples    int
+	peak       float64
+	outChunks  int
+}
+
+// Params configures the Vobiz serializer.
+type Params struct {
+	VobizSampleRate int
+	SampleRate      int
+}
+
+// NewSerializer returns a Vobiz serializer.
+func NewSerializer(streamSid, callSid string, params *Params) *Serializer {
+	s := &Serializer{
+		StreamSid: streamSid,
+		CallSid:   callSid,
+		VobizRate: 8000,
+		Encoding:  "audio/x-mulaw",
+	}
+	if params != nil {
+		if params.VobizSampleRate > 0 {
+			s.VobizRate = params.VobizSampleRate
+		}
+		s.SampleRate = params.SampleRate
+	}
+	return s
+}
+
+// Setup implements serialize.SerializerWithSetup.
+func (s *Serializer) Setup(start *frames.StartFrame) {
+	if start != nil && s.SampleRate == 0 {
+		s.SampleRate = start.AudioInSampleRate
+	}
+	if s.SampleRate == 0 {
+		s.SampleRate = 16000
+	}
+}
+
+// Serialize implements serialize.Serializer.
+func (s *Serializer) Serialize(f frames.Frame) ([]byte, error) {
+	data, _, err := s.serialize(f)
+	return data, err
+}
+
+func (s *Serializer) serialize(f frames.Frame) ([]byte, bool, error) {
+	switch v := f.(type) {
+	case *frames.InterruptionFrame:
+		// Vobiz expects clearAudio to stop playback
+		out := map[string]string{"event": "clearAudio", "streamId": s.StreamSid}
+		b, err := json.Marshal(out)
+		return b, false, err
+	case *frames.AudioRawFrame:
+		return s.serializeAudio(v.Audio, v.SampleRate)
+	case *frames.TTSAudioRawFrame:
+		return s.serializeAudio(v.Audio, v.SampleRate)
+	case *frames.OutputAudioRawFrame:
+		return s.serializeAudio(v.Audio, v.SampleRate)
+	case *frames.TransportMessageFrame:
+		return nil, false, nil
+	}
+	return nil, false, nil
+}
+
+func (s *Serializer) serializeAudio(pcm []byte, inRate int) ([]byte, bool, error) {
+	if s.StreamSid == "" {
+		return nil, false, fmt.Errorf("vobiz playback has no streamId")
+	}
+	if inRate <= 0 || len(pcm)%2 != 0 {
+		return nil, false, fmt.Errorf("invalid playback PCM/rate")
+	}
+	var resampled []byte
+	if inRate != 8000 {
+		resampled = audio.Resample16MonoAlloc(pcm, inRate, 8000)
+	} else {
+		resampled = pcm
+	}
+	ulawBytes := audio.EncodeULaw(resampled)
+	if len(ulawBytes) == 0 {
+		return nil, false, nil
+	}
+	payload := base64.StdEncoding.EncodeToString(ulawBytes)
+	// Vobiz expects: {event: "playAudio", media: {contentType, sampleRate, payload}}
+	out := map[string]interface{}{
+		"event":    "playAudio",
+		"streamId": s.StreamSid,
+		"media": map[string]interface{}{
+			"contentType": "audio/x-mulaw",
+			"sampleRate":  8000,
+			"payload":     payload,
+		},
+	}
+	b, err := json.Marshal(out)
+	s.outChunks++
+	if s.outChunks == 1 || s.outChunks%50 == 0 {
+		logger.Info("vobiz playback: chunks=%d ulaw_bytes=%d rate=8000 stream_id_present=true", s.outChunks, len(ulawBytes))
+	}
+	return b, false, err
+}
+
+// Deserialize implements serialize.Serializer.
+// Vobiz input is Twilio-compatible: start, media, stop events.
+func (s *Serializer) Deserialize(data []byte) (frames.Frame, error) {
+	var msg struct {
+		Event string `json:"event"`
+		Start struct {
+			StreamSid   string `json:"streamSid"`
+			StreamId    string `json:"streamId"`
+			CallSid     string `json:"callSid"`
+			CallId      string `json:"callId"`
+			MediaFormat struct {
+				Encoding   string `json:"encoding"`
+				SampleRate int    `json:"sampleRate"`
+				Channels   int    `json:"channels"`
+			} `json:"mediaFormat"`
+		} `json:"start"`
+		Media struct {
+			Payload string `json:"payload"`
+		} `json:"media"`
+	}
+	if err := json.Unmarshal(data, &msg); err != nil {
+		return nil, err
+	}
+	switch msg.Event {
+	case "start":
+		mf := msg.Start.MediaFormat
+		if mf.Encoding != "" {
+			s.Encoding = strings.ToLower(mf.Encoding)
+		}
+		if mf.SampleRate > 0 {
+			s.VobizRate = mf.SampleRate
+		}
+		if mf.Channels > 1 || (s.Encoding != "audio/x-mulaw" && s.Encoding != "audio/x-l16") || (s.Encoding == "audio/x-mulaw" && s.VobizRate != 8000) || (s.Encoding == "audio/x-l16" && s.VobizRate != 8000 && s.VobizRate != 16000) {
+			return nil, fmt.Errorf("unsupported vobiz inbound media format: %s/%d channels=%d", s.Encoding, s.VobizRate, mf.Channels)
+		}
+		logger.Info("vobiz inbound format: encoding=%s rate=%d channels=%d", s.Encoding, s.VobizRate, mf.Channels)
+		if msg.Start.StreamId != "" {
+			s.StreamSid = msg.Start.StreamId
+		}
+		if msg.Start.CallId != "" {
+			s.CallSid = msg.Start.CallId
+		}
+		if msg.Start.StreamSid != "" {
+			s.StreamSid = msg.Start.StreamSid
+		}
+		if msg.Start.CallSid != "" {
+			s.CallSid = msg.Start.CallSid
+		}
+		return nil, nil
+	case "media":
+		if msg.Media.Payload == "" {
+			return nil, nil
+		}
+		ulawBytes, err := base64.StdEncoding.DecodeString(msg.Media.Payload)
+		if err != nil || len(ulawBytes) == 0 {
+			return nil, nil
+		}
+		pcm := ulawBytes
+		if s.Encoding == "audio/x-mulaw" {
+			pcm = audio.DecodeULaw(ulawBytes)
+		} else if len(pcm)%2 != 0 {
+			return nil, fmt.Errorf("odd-length L16 PCM")
+		}
+		if len(pcm) == 0 {
+			return nil, nil
+		}
+		sr := s.SampleRate
+		if sr == 0 {
+			sr = 16000
+		}
+		if s.VobizRate != sr {
+			pcm = audio.Resample16MonoAlloc(pcm, s.VobizRate, sr)
+		}
+		s.chunks++
+		for i := 0; i+1 < len(pcm); i += 2 {
+			v := float64(int16(binary.LittleEndian.Uint16(pcm[i:]))) / 32768
+			s.sumSquares += v * v
+			s.samples++
+			if math.Abs(v) > s.peak {
+				s.peak = math.Abs(v)
+			}
+		}
+		if s.chunks%100 == 0 {
+			logger.Info("vobiz inbound aggregate: chunks=%d rms=%.5f peak=%.5f pcm_rate=%d", s.chunks, math.Sqrt(s.sumSquares/float64(s.samples)), s.peak, sr)
+		}
+		return frames.NewAudioRawFrame(pcm, sr, 1, 0), nil
+	case "stop":
+		return &frames.EndFrame{}, nil
+	}
+	return nil, nil
+}
+
+// Ensure Serializer implements the interfaces.
+var (
+	_ serialize.Serializer          = (*Serializer)(nil)
+	_ serialize.SerializerWithSetup = (*Serializer)(nil)
+)
diff --git a/pkg/frames/serialize/vobiz/vobiz_test.go b/pkg/frames/serialize/vobiz/vobiz_test.go
new file mode 100644
index 0000000..495b6f3
--- /dev/null
+++ b/pkg/frames/serialize/vobiz/vobiz_test.go
@@ -0,0 +1,85 @@
+package vobiz
+
+import (
+	"encoding/base64"
+	"encoding/binary"
+	"encoding/json"
+	"fmt"
+	"github.com/Voxray-AI/Voxray/pkg/audio"
+	"github.com/Voxray-AI/Voxray/pkg/frames"
+	"math"
+	"testing"
+)
+
+func TestVobizIDs(t *testing.T) {
+	s := NewSerializer("", "", nil)
+	_, e := s.Deserialize([]byte(`{"event":"start","start":{"streamId":"test-stream","callId":"test-call"}}`))
+	if e != nil {
+		t.Fatal(e)
+	}
+	b, e := s.Serialize(frames.NewAudioRawFrame([]byte{0, 0, 0, 0}, 8000, 1, 0))
+	if e != nil {
+		t.Fatal(e)
+	}
+	var m map[string]interface{}
+	json.Unmarshal(b, &m)
+	if m["streamId"] != "test-stream" {
+		t.Fatalf("missing streamId: %s", b)
+	}
+	b, e = s.Serialize(&frames.InterruptionFrame{})
+	if e != nil {
+		t.Fatal(e)
+	}
+	json.Unmarshal(b, &m)
+	if m["streamId"] != "test-stream" {
+		t.Fatal("clear lacks ID")
+	}
+}
+
+func TestFormatsAndPlayback(t *testing.T) {
+	for _, enc := range []string{"audio/x-mulaw", "audio/x-l16"} {
+		s := NewSerializer("", "", nil)
+		start := fmt.Sprintf(`{"event":"start","start":{"streamId":"synthetic","callId":"test","mediaFormat":{"encoding":%q,"sampleRate":8000}}}`, enc)
+		if _, err := s.Deserialize([]byte(start)); err != nil {
+			t.Fatal(err)
+		}
+		pcm := make([]byte, 320)
+		for i := 0; i < 160; i++ {
+			binary.LittleEndian.PutUint16(pcm[i*2:], uint16(int16(800*math.Sin(float64(i)*2*math.Pi*440/8000))))
+		}
+		payload := pcm
+		if enc == "audio/x-mulaw" {
+			payload = audio.EncodeULaw(pcm)
+		}
+		raw := fmt.Sprintf(`{"event":"media","media":{"payload":%q}}`, base64.StdEncoding.EncodeToString(payload))
+		f, err := s.Deserialize([]byte(raw))
+		if err != nil {
+			t.Fatal(err)
+		}
+		a := f.(*frames.AudioRawFrame)
+		if len(a.Audio) != 640 || a.SampleRate != 16000 {
+			t.Fatalf("wrong decoded frame: %d/%d", len(a.Audio), a.SampleRate)
+		}
+		out, err := s.Serialize(a)
+		if err != nil {
+			t.Fatal(err)
+		}
+		var m struct {
+			StreamId string
+			Media    struct {
+				ContentType string
+				SampleRate  int
+				Payload     string
+			}
+		}
+		json.Unmarshal(out, &m)
+		b, _ := base64.StdEncoding.DecodeString(m.Media.Payload)
+		if m.StreamId != "synthetic" || m.Media.ContentType != "audio/x-mulaw" || m.Media.SampleRate != 8000 || len(b) != 160 {
+			t.Fatalf("bad playback: %s", out)
+		}
+	}
+	s := NewSerializer("", "", nil)
+	if _, err := s.Deserialize([]byte(`{"event":"start","start":{"mediaFormat":{"encoding":"bad","sampleRate":8000}}}`)); err == nil {
+		t.Fatal("unsupported format accepted")
+	}
+}
